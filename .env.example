# Value Bet Pro - variables d'environnement
# Toutes ces variables sont a configurer dans Vercel : Settings > Environment Variables
# Ne jamais commiter le fichier .env reel.

# === Veille evenementielle (api/veille-cron.js + api/veille-get.js) ===

# Cle API Mistral (https://console.mistral.ai/)
# Utilisee par le cron quotidien pour categoriser et scorer les news des 3 equipes
MISTRAL_API_KEY=

# Token de lecture/ecriture Vercel Blob (storage du JSON de veille)
# Genere via : Vercel Dashboard > Storage > Blob > Create Store > .env.local download
# Ou via CLI : vercel blob create veille-bet-pro
BLOB_READ_WRITE_TOKEN=

# Secret aleatoire qui protege le endpoint /api/veille-cron contre les appels manuels
# Vercel Cron envoie automatiquement le header Authorization: Bearer ${CRON_SECRET}
# Genere avec : openssl rand -base64 32 (ou n'importe quelle string aleatoire 32+ chars)
CRON_SECRET=

# === Live odds (api/live-odds.js) - existant ===

# Cle The Odds API (https://the-odds-api.com/) - free tier 500 req/mois
THE_ODDS_API_KEY=
